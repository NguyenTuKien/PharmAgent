	},
	"item": [
		{
			"name": "1) Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
							"const data = pm.response.json();",
							"pm.collectionVariables.set('accessToken', data.accessToken || '');",
							"pm.collectionVariables.set('refreshToken', data.refreshToken || '');",
							"const profiles = data?.profiles?.content || [];",
							"if (profiles.length > 0) {",
							"  pm.collectionVariables.set('profileId', profiles[0].id || '');",
							"} else {",
							"  pm.collectionVariables.set('profileId', '');",
							"  console.warn('No profile in login response. Create one first.');",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/auth/login?page=0&size=10",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"auth",
						"login"
					],
					"query": [
						{
							"key": "page",
							"value": "0"
						},
						{
							"key": "size",
							"value": "10"
						}
					]
				}
			},
			"response": []
		},
